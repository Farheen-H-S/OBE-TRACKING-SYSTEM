# -----------------------------------------------------------------------------
# OBE-TRACKING-SYSTEM Backend Environment Configuration Template
# Instructions: Copy this file to a new file named '.env' and fill in your values.
# DO NOT commit your actual '.env' file containing real passwords to Git!
# -----------------------------------------------------------------------------

# Set to True for local development, False in Production (Render)
DEBUG=True

# Generate a unique secret key for your deployment
DJANGO_SECRET_KEY=your_django_secret_key_here

# System automated email configurations
EMAIL_HOST_USER=obe.tracking.system@gmail.com
# Generate a new 16-character Google App Password for this to function
EMAIL_HOST_PASSWORD=your_gmail_app_password_here

# URL where your React frontend is running
FRONTEND_URL=http://localhost:3000

# Comma-separated list of host/domain names that this Django site can serve
ALLOWED_HOSTS=127.0.0.1,localhost,://onrender.com
